    },
    {
      "para_index": 23,
      "text": "02 \u7528\u6237\u75db\u70b9",
      "style": "Normal"
    },
    {
      "para_index": 28,
      "text": "03 \u6838\u5fc3\u529f\u80fd",
      "style": "Normal"
    },
    {
      "para_index": 29,
      "text": "\u6838\u5fc3\u529f\u80fd 1\uff5c\u5bb6\u5ead\u80fd\u6e90 Autopilot",
      "style": "GH Page Title"
    },
    {
      "para_index": 34,
      "text": "\u7ed9\u7528\u6237\u7684\u4ef7\u503c\uff1a\u7528\u6237\u4e0d\u518d\u9700\u8981\u6210\u4e3a\u201c\u5bb6\u5ead\u80fd\u6e90\u8c03\u5ea6\u5458\u201d\u3002\u5e73\u65f6\u65e0\u9700\u4ecb\u5165\uff0c\u771f\u6b63\u503c\u5f97\u51b3\u5b9a\u65f6\u7cfb\u7edf\u624d\u6765\u627e\u7528\u6237\u3002",
      "style": "Normal"
    },
    {
      "para_index": 38,
